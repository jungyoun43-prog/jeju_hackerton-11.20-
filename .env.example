# 기본 실행에는 키가 필요하지 않습니다. 실제 비밀값을 제출하지 마세요.
HOST=127.0.0.1
PORT=4173
# 시연 규모의 일반 지도 보기. 공급자 변경 시 이용조건과 출처 표기도 확인하세요.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# 아래 한 줄에 본인의 OpenAI API 키를 입력하고 npm run dev를 다시 실행하세요.
# 비어 있으면 모델 미연결 상태로 실행되며 고정 미리보기는 계속 사용할 수 있습니다.
OPENAI_API_KEY=

# 기본 Sol. Terra를 쓰려면 gpt-6.1-terra로 바꾸세요. 두 모델을 동시에 호출하지 않습니다.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_REALTIME_DAILY_SESSION_LIMIT=3
# 실시간 음성은 로컬 Node 서버에서 최대 3분, 동시 1건. 기본 loopback만 허용합니다.
# HTTPS로 별도 운영할 때만 정확한 원점을 지정합니다. AWS 배포는 별도 구현입니다.
# REALTIME_ALLOWED_ORIGIN=https://your-domain.example
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_MS=40000

# 실제 Responses 전송 시도(성공/실패 모두), UTC 하루 기준. 최대 80까지 설정 가능.
OPENAI_DAILY_CALL_LIMIT=60
# 한 대화 요청의 내부 API 호출 상한(1~8). 호출당 출력 상한은 위 설정을 사용.
OPENAI_MAX_CALLS_PER_TURN=6
DEMO_DAILY_TURN_LIMIT=20
# 로컬 카운터는 .runtime/openai-usage에 유지. 여러 로컬 인스턴스는 같은 디렉터리 사용.
# OPENAI_USAGE_DIR=

# 별도 운영자용 AI 발신 어댑터. 일반 앱과 phone:preview는 실제 발신하지 않습니다.
# 자세한 운영자 요청 계약: docs/outbound-phone-adapter.md
PHONE_OUTBOUND_ENABLED=false
PHONE_OUTBOUND_LIVE_ACK=
PHONE_ALLOWED_NUMBERS=
PHONE_PUBLIC_ORIGIN=
PHONE_PORT=4190
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
